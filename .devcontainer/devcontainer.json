{
  "name": "Thai Insurance Ops Agent",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "postCreateCommand": "pip install -r requirements.txt",
  "forwardPorts": [7860, 8000],
  "portsAttributes": {
    "7860": { "label": "Web demo", "onAutoForward": "openBrowser" },
    "8000": { "label": "REST API", "onAutoForward": "notify" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  }
}
